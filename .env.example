# EBM Enterprise Vault - Secrets Example
# Copy these keys into your GitHub Repository Secrets (Settings > Secrets and variables > Actions)

# GitHub Personal Access Token (PAT) for reading releases from private repo (if applicable)
UPDATE_PAT=your_github_pat_here

# Super Admin Authorization Credentials
ADMIN_EMAIL=admin@ebfic.store
ADMIN_PASS1=ebfic
ADMIN_PASS2=admin
ADMIN_PASS3=786

# AES Encryption Key (32-character string recommended)
AES_KEY=ebfic-ebm-central-secure-key-32b
